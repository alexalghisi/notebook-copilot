{
    "name": "notebook-copilot",
    "private": true,
    "version": "0.1.0",
    "description": "A collaborative SQL notebook (Yjs over websockets, Postgres, Redis) with a tool-using copilot, a context packer with a token budget, and an eval suite.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
        "dev:server": "tsx watch src/server/main.ts",
        "dev:web": "vite",
        "start": "tsx src/server/main.ts",
        "build": "vite build",
        "db:setup": "tsx scripts/setup-db.ts",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "evals": "tsx evals/run.ts"
    },
    "dependencies": {
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.13",
        "codemirror": "^6.0.2",
        "diff": "^9.0.0",
        "gpt-tokenizer": "^4.0.0",
        "graphql": "^17.0.2",
        "graphql-yoga": "^5.24.1",
        "ioredis": "^6.0.0",
        "lib0": "^0.2.119",
        "pg": "^8.23.1",
        "pg-cursor": "^2.22.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "ws": "^8.22.0",
        "y-codemirror.next": "^0.3.6",
        "y-protocols": "^1.0.7",
        "y-websocket": "^3.1.0",
        "yjs": "^13.6.33",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "@types/pg-cursor": "^2.7.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.12.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "playwright-core": "^1.63.0",
        "tsx": "^4.23.15",
        "typescript": "~5.9",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    }
}
