# Application database (notebooks, CRDT updates, runs, copilot requests)
DATABASE_URL=postgres://synckit:synckit@localhost:5432/dn_app
# Sample dataset queried by SQL cells, through a read-only role
SAMPLE_DATABASE_URL=postgres://dn_reader:dn_reader@localhost:5432/dn_sample
# Admin connection used only by `npm run db:setup` to create databases and the read-only role
ADMIN_DATABASE_URL=postgres://synckit:synckit@localhost:5432/postgres
REDIS_URL=redis://localhost:6379
PORT=4710
# Optional: any OpenAI-compatible chat completions endpoint. Without a key the offline model is used.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
